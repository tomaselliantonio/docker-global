# Copia in .env oppure lancia ./setup.sh (genera tutto da solo con valori casuali).
# .env NON va committato.
MINIO_ROOT_USER=dev
MINIO_ROOT_PASSWORD=
LINKDING_PASSWORD=
CONVERTX_JWT=
BESZEL_PASSWORD=
# riempiti da setup.sh dopo il primo avvio:
GITEA_RUNNER_TOKEN=
BESZEL_KEY=
# percorso assoluto di ./backups (per i container di backup); vuoto = ./backups
BACKUP_HOST_DIR=
# profilo attivato da setup.sh quando runner e agente Beszel sono configurati
COMPOSE_PROFILES=
